{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glu",
  "version": "0.6.0",
  "identifier": "com.glu.meetingai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Glu",
        "label": "main",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost https://*.supabase.co; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/**",
          "$APPDATA/accounts/*/recordings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}
